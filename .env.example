# Copiez ce fichier vers .env et remplissez vos propres valeurs.
# Ne partagez JAMAIS votre fichier .env rempli (il contient des secrets).

# --- LLM local (llama.cpp) ---
LLAMA_SERVER_URL=http://127.0.0.1:8080
LLAMA_MODEL_NAME=qwen3-4b-instruct

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- System prompt du chat ---
SYSTEM_PROMPT=Tu es MiniLLM, un assistant IA local. Tu réponds en français sauf si on te demande explicitement une autre langue. Tu es utile, concis et honnête.

# --- Envoi d'email (SMTP Gmail) ---
# 1. Activez la validation en 2 étapes : https://myaccount.google.com/security
# 2. Générez un mot de passe d'application : https://myaccount.google.com/apppasswords
# 3. Collez-le ci-dessous (jamais votre mot de passe Gmail normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
SMTP_APP_PASSWORD=

# --- Gemini (optionnel — uniquement si vous voulez utiliser l'API Gemini au lieu du LLM local pour certaines tâches) ---
# Clé gratuite ici : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
